# Use one of these for the analyze API (LLM). Watsonx = IBM prize (priority if set).
# Watsonx (IBM) — get key + project: https://dataplatform.cloud.ibm.com/developer-access?context=wx
# WATSONX_AI_AUTH_TYPE=iam
# WATSONX_AI_APIKEY=your_ibm_cloud_api_key
# WATSONX_PROJECT_ID=your_watsonx_project_id
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: app URL for extension / CORS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: database (for profile / report / heatmap)
# DATABASE_URL=postgresql://...
# or Supabase: NEXT_PUBLIC_SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=...
